# AJAS local / CI data-plane settings.
# Copy to `.env` or `backend/local.settings.json` Values. Never commit secrets.

# Cosmos DB (empty connection string = in-memory / FakeDatabase)
COSMOS_CONNECTION_STRING=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=ajas
COSMOS_CONSISTENCY=Session
COSMOS_PREFERRED_REGIONS=
COSMOS_THROUGHPUT_MODE=serverless
COSMOS_AUTOSCALE_MAX_RU=4000
COSMOS_DAILY_RU_BUDGET=250000
COSMOS_QUERY_STRICT=true

# Azure Storage / Azurite. Account URLs enable managed identity in Azure.
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
BLOB_ACCOUNT_URL=
QUEUE_CONNECTION_STRING=UseDevelopmentStorage=true
QUEUE_ACCOUNT_URL=

# Auth: "dev" accepts Bearer <user_id>; "aad" validates a JWT via azure-identity / JWKS
AUTH_MODE=dev
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=
AUTH_JWT_JWKS_URL=

# Optional Azure AD app for Microsoft 365 mail
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional Key Vault (DefaultAzureCredential / azure-identity)
KEY_VAULT_URI=

# Frontend
VITE_USE_MOCK=false
VITE_AUTH_MODE=dev
